# =============================================================================
# XENONITE 4-LAYER STACK - SELF-HOSTED ENVIRONMENT CONFIGURATION
# Copy this file to .env and customize for local Docker or Remote Hub (Tailscale)
# =============================================================================

# --- Layer 1: Persistent Memory ---
# Backend mode:
#   auto   = Try Qdrant + TEI first, seamlessly fallback to local SQLite FTS5 if offline
#   qdrant = Strictly use Qdrant + TEI vector database
#   sqlite = Lightweight zero-Docker local SQLite FTS5 store (~/.xenonite/memory.db)
XENONITE_MEMORY_BACKEND=auto

# Local Docker or Remote Tailscale/LAN Hub URLs
XENONITE_QDRANT_URL=http://127.0.0.1:6333
XENONITE_TEI_URL=http://127.0.0.1:8080/embed
XENONITE_QDRANT_COLLECTION=mem0
XENONITE_QDRANT_VECTOR_SIZE=1024
XENONITE_QDRANT_API_KEY=

# SQLite FTS5 fallback database path (defaults to ~/.xenonite/memory.db)
XENONITE_SQLITE_PATH=

# Identity metadata stored on memory points
XENONITE_USER_ID=developer
XENONITE_AGENT_ID=xenonite-nucleus

# --- Layer 2: Sovereign Web Intelligence ---
XENONITE_SEARXNG_URL=http://127.0.0.1:8888
XENONITE_CRAWL4AI_URL=http://127.0.0.1:11235
# Optional Bearer token if your Crawl4AI container enables CRAWL4AI_API_TOKEN
XENONITE_CRAWL4AI_TOKEN=
XENONITE_CRAWL4AI_MAX_CHARS=6000

# --- Layer 3: Local Code Intelligence Binaries (Optional Overrides) ---
# Leave blank to auto-detect from system PATH via shutil.which()
XENONITE_RG_BIN=
XENONITE_SG_BIN=
XENONITE_MADGE_BIN=

# --- Anti-Churn Hook Tuning ---
XENONITE_CHURN_STEP_WINDOW=4
XENONITE_CHURN_TIME_WINDOW_SEC=20.0

# --- Docker Compose Settings (Optional) ---
SEARXNG_SECRET=change-this-random-secret-key-before-deploy
TEI_MODEL_ID=BAAI/bge-m3
